{
  "name": "tetris-manager-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:check": "npm run security:test && npm run security:secrets && npm run security:history && npm run security:audit && npm run build && npm run security:artifacts",
    "security:history": "node scripts/check-secrets.mjs --history",
    "security:artifacts": "node scripts/check-secrets.mjs --dist",
    "security:test": "node --test scripts/check-secrets.test.mjs",
    "security:install-hooks": "git config --local core.hooksPath .githooks"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
